{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fit2csv",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "migrations": [
    {
      "tag": "v1-ai-daily-limit",
      "new_sqlite_classes": [
        "AiDailyLimit"
      ]
    },
    {
      "tag": "v2-remove-ai-daily-limit",
      "deleted_classes": [
        "AiDailyLimit"
      ]
    }
  ]
}
