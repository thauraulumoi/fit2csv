{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fit2csv",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  }
}
